<% layout("/layouts/boilerplate"); %>

<div class="profile-page container my-5 d-flex flex-column align-items-center">
  <div class="position-relative mb-3">
    <img src="<%= user.avatar || 'https://res.cloudinary.com/dmj1qvwjh/image/upload/v1763564844/user_profile_itdstt.webp' %>" alt="Avatar" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
  </div>

  <% if (user.bio) { %>
  <div class="bio-section text-center mb-3">
    <p class="text-muted"> <%= user.bio %> </p>
  </div>
  <% } %>

  <div class="text-center mb-3">
    <h2 class="fw-bold mb-1"> <%= user.fullName %> </h2>

    <p class="text-muted mb-1">
      <i class="fas fa-envelope me-2"> </i> <%= user.email %>
    </p>

    <% if (user.phone) { %>
    <p class="text-muted mb-1">
      <i class="fas fa-phone me-2"> </i> <%= user.phone %>
    </p>
    <% } %>

    <% if (currentUser && currentUser._id.equals(user._id)) { %>
    <a href="/profile/edit" class="btn btn-danger btn-sm mt-3">Edit Profile</a> <br>
    <a href="/user/<%= currentUser.username %>/listings" class="btn btn-dark btn-sm mt-3">View My Listings</a>
    <% }  else { %>
    <a href="/user/<%= user.username %>/listings" class="btn btn-dark btn-sm mt-3">View <%= user.fullName || user.username %>'s Listings </a>
    <% } %>
  </div>
</div>