<% layout("/layouts/boilerplate"); %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <h1 class="text-center mb-4">Sign Up on Nestify</h1>
    <div class="col-12 col-sm-8 col-md-6">
      <form action="/signup" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input name="username" type="text" class="form-control" required id="username" placeholder="Enter your username">
          <div class="valid-feedback">
            Looks good!
          </div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input name="email" type="email" class="form-control" required id="email" placeholder="Enter your email">
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input name="password" type="password" class="form-control" required id="password" placeholder="Enter your password">
        </div>
        <button class="btn btn-success">Sign Up</button>
      </form>

      <p class="mt-3 text-center">
        Already have an account? <a href="/login">Sign In</a>
      </p>
    </div>
  </div>
</div>