<% layout("/layouts/boilerplate"); %>

<div class="container mt-4">
  <h1 class="mb-4 text-center"><%= user.fullName || user.username %>'s Listings</h1>

  <% if (listings.length > 0) { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    <% listings.forEach(listing => { %>
    <div class="col">
      <div class="card h-100">
        <img src="<%= listing.image.url %>" class="card-img-top" style="height: 180px; object-fit: cover;">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= listing.title %> </h5>
          <p class="card-text flex-grow-1"><%= listing.description %> </p>
          <p class="card-text"><strong>$<%= listing.price %></strong> </p>
          <a href="/listings/<%= listing._id %>" class="btn btn-primary mt-auto">View Details</a>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="alert alert-info text-center">
    This user hasn't created any listings yet.
  </div>
  <% } %>

  <div class="text-center mt-3">
    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
  </div>
</div>