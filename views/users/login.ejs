<% layout("/layouts/boilerplate"); %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <h1 class="text-center mb-4">Log in</h1>
    <div class="col-12 col-sm-8 col-md-6">
      <form action="/login" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input name="email" type="email" class="form-control" required id="email" placeholder="Enter your email" />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input name="password" type="password" class="form-control" required id="password" placeholder="Enter your password" />
        </div>
        <button class="btn btn-success">Log in</button>
      </form>
      <p class="mt-3 text-center">
        Don't have an account? <a href="/signup">Register</a>
      </p>
    </div>
  </div>
</div>