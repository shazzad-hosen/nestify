<div>
  <% if (successMessage && successMessage.length) { %>
  <div class="alert alert-success mt-3 col-6 offset-3 alert-dismissible fade show" role="alert">
    <%= successMessage %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>
</div>
<div>
  <% if (errorMessage && errorMessage.length) { %>
  <div class="alert alert-danger mt-3 col-6 offset-3 alert-dismissible fade show" role="alert">
    <%= errorMessage %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>
</div>