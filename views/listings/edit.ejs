<% layout("/layouts/boilerplate"); %>

<div class="container mt-3">
  <h2 class="text-center mb-4">Edit Your Listing</h2>
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input name="title" type="text" class="form-control" value="<%= listing.title %>" required>
          <div class="valid-feedback">
            Looks good!
          </div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="description" class="form-control" required><%=listing.description%></textarea>
          <div class="invalid-feedback">
            Please enter a short description!
          </div>
        </div>

        <!-- Previous Image -->
        <div class="mb-3 text-center">
          <img src="<%= originalImage %>" alt="Previous Listing Image" class="img-fluid rounded">
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image</label>
          <input name="image" type="file" class="form-control">
        </div>

        <div class="row">
          <div class="mb-3 col-12 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="price" type="number" class="form-control" value="<%= listing.price %>" required>
            <div class="invalid-feedback">
              Price should be valid!
            </div>
          </div>

          <div class="mb-3 col-12 col-md-4">
            <label for="category" class="form-label">Category</label>
            <select class="form-select" id="category" name="category" required>
              <option value="<%=listing.category%>">-- Change Category --</option>
              <option value="Trending">Trending</option>
              <option value="Iconic Cities">Iconic Cities</option>
              <option value="Rooms">Rooms</option>
              <option value="Mountains">Mountains</option>
              <option value="Castles">Castles</option>
              <option value="Amazing Pools">Amazing Pools</option>
              <option value="Farms">Farms</option>
              <option value="Camping">Camping</option>
              <option value="Arctic">Arctic</option>
              <option value="Beaches">Beaches</option>
              <option value="Rivers">Rivers</option>
              <option value="Modern Cities">Modern Cities</option>
              <option value="Others">Others</option>
            </select>
          </div>

          <div class="mb-3 col-12 col-md-4">
            <label for="country" class="form-label">Country</label>
            <input name="country" type="text" class="form-control" value="<%= listing.country %>" required>
            <div class="invalid-feedback">
              Country name should be valid!
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input name="location" type="text" class="form-control" value="<%= listing.location %>" required>
          <div class="invalid-feedback">
            Location should be valid!
          </div>
        </div>

        <div class="mb-3">
          <button class="btn btn-success">Update Listing</button>
        </div>
      </form>
    </div>
  </div>
</div>