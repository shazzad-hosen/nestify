<% layout("/layouts/boilerplate"); %>

<style>
  /* Search Bar */
  #filters {
    display: flex;
    flex-wrap: wrap;
  }

  .filter {
    text-align: center;
    margin-top: 2rem;
    margin-right: 2rem;
    opacity: 0.8;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  i {
    font-size: 1.3rem;
  }

  .form-control {
    padding: 12px 15px;
    padding-right: 40px;
    border: none;
    box-shadow: none;
  }

  .form-control:focus {
    box-shadow: none;
    border-color: #ddd;
  }

  button:focus {
    outline: none;
    box-shadow: none;
  }

  .search-box {
    border-radius: 50px;
    overflow: hidden;
  }

  #filters a {
    text-decoration: none;
    color: rgb(8, 1, 1);
  }

  /* Mobile search adjustments */
  @media (max-width: 576px) {
    .search-mobile {
      width: 90% !important;
      margin: auto;
    }

    .card-img-top {
      height: 15rem !important;
      object-fit: cover;
      object-fit: cover !important;
    }
  }
</style>

<form action="/search" method="GET">
  <div class="container mt-4 col-10 col-sm-6 offset-sm-3 position-relative search-mobile">
    <input type="text" id="searchBox" name="search" class="form-control rounded-pill pe-5 shadow-sm" placeholder="Search destinations...">
    <button type="submit" class="position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3">
      <i class="fa-solid fa-magnifying-glass" style="color: rgb(228, 22, 22);"></i>
    </button>
  </div>
</form>


<div id="filters" class="d-none d-lg-flex">
  <a href="/search?search=Trending">
    <div class="filter">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </div>
  </a>

  <a href="/search?search=Iconic+Cities">
    <div class="filter">
      <i class="fa-solid fa-city"></i>
      <p>Iconic Cities</p>
    </div>
  </a>

  <a href="/search?search=Rooms">
    <div class="filter">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </div>
  </a>

  <a href="/search?search=Mountains">
    <div class="filter">
      <i class="fa-solid fa-mountain-city"></i>
      <p>Mountains</p>
    </div>
  </a>

  <a href="/search?search=Castles">
    <div class="filter">
      <i class="fa-brands fa-fort-awesome"></i>
      <p>Castles</p>
    </div>
  </a>

  <a href="/search?search=Amazing+Pools">
    <div class="filter">
      <i class="fa-solid fa-water-ladder"></i>
      <p>Amazing Pools</p>
    </div>
  </a>

  <a href="/search?search=Farms">
    <div class="filter">
      <i class="fa-solid fa-tractor"></i>
      <p>Farms</p>
    </div>
  </a>

  <a href="/search?search=Camping">
    <div class="filter">
      <i class="fa-solid fa-tents"></i>
      <p>Camping</p>
    </div>
  </a>

  <a href="/search?search=Arctic">
    <div class="filter">
      <i class="fa-regular fa-snowflake"></i>
      <p>Arctic</p>
    </div>
  </a>

  <a href="/search?search=Beaches">
    <div class="filter">
      <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beaches</p>
    </div>
  </a>

  <a href="/search?search=Rivers">
    <div class="filter">
      <i class="fa-brands fa-red-river"></i>
      <p>Rivers</p>
    </div>
  </a>

  <a href="/search?search=Modern+Cities">
    <div class="filter">
      <i class="fa-solid fa-building"></i>
      <p>Modern Cities</p>
    </div>
  </a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mt-3" id="content">
  <% for(let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%= listing.image.url %>" name="image" class="card-img-top" alt="Listing Image" style="height: 20rem">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b> <%= listing.title %> <br> </b>
          &#2547 <%= listing.price.toLocaleString("en-BD") %> / night
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>